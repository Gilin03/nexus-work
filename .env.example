# 복사해서 .env 로 쓰고 값을 바꾼다. .env 는 Git 에 올리지 않는다.
# 아래는 예시 자리표시자이며 실제 값이 아니다.
MYSQL_ROOT_PASSWORD=change-me-root
NEXUS_APP_PASSWORD=change-me-app
NEXUS_CONF_PASSWORD=change-me-conf

DB_HOST=127.0.0.1
DB_PORT=3307
# DB 포트를 열 주소. 기본은 127.0.0.1(이 PC 안에서만). n8n 장비가 붙어야 할 때만 0.0.0.0 + 방화벽 차단 규칙(docs/03_팀_연동안내.md)
DB_BIND=127.0.0.1
DB_NAME=nexus

# 32자 이상 임의 문자열
SECRET_KEY=change-me-to-a-long-random-string-32chars-min
# 로컬 HTTP 개발이면 0, HTTPS 뒤에서는 1
COOKIE_SECURE=0

# 시드 계정 비밀번호 (12자 이상)
SEED_KIM_PW=ChangeMe-Kim-2026!
SEED_LEE_PW=ChangeMe-Lee-2026!
SEED_ADMIN_PW=ChangeMe-Admin-2026!

# 포털 실행 주소(run.py). 내 PC에서만 쓰면 127.0.0.1, 다른 장비(네트워크 담당 장비·Kali)에서 접속하게 하려면 0.0.0.0
APP_HOST=127.0.0.1
APP_PORT=5070

# 실습 시나리오(기획서 4.1)용 내부 API 토큰(가상). seed.py 가 기밀 문서 M&A_PLAN 에 넣고, 내부 API 가 같은 값으로 검사한다.
# 실제 값은 팀 채팅으로만 공유하고 문서·Git 에 쓰지 않는다. 만들기:
#   python -c "import secrets; print('nxapi_' + secrets.token_urlsafe(24))"
LAB_INTERNAL_API_TOKEN=change-me-lab-token

# 무료 AI 어시스턴트 설정
# AI_PROVIDER: auto (기본값: Gemini 키 -> Groq 키 -> 로컬 Ollama -> 내장 사내 어시스턴트 순 자동 선택)
#              ollama | gemini | groq | builtin | placeholder
AI_PROVIDER=auto
AI_TIMEOUT=60

# 1) 로컬 Ollama (API 키 불필요, https://ollama.com 설치 후 `ollama pull qwen2.5:7b`)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# 2) Google Gemini 무료 API (https://aistudio.google.com/apikey 에서 무료 발급)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 3) Groq 무료 클라우드 API (https://console.groq.com/keys 에서 무료 발급)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# n8n 대응 워크플로 전용 DB 계정(scripts/create_n8n_account.py 가 비어 있으면 만들어 채운다). 팀 채팅에 쓰지 말고 .env 로만 전달한다.
N8N_DB_USER=nexus_n8n
N8N_DB_PASSWORD=

# ---- 팀 연동(nexus_team_integration.py, 기본 꺼짐) ----
# 보안 이벤트를 GELF(UDP)로 Graylog 에 보낸다. 허용한 필드만 보내고 쿼리 문자열·자유 문장은 뺀다.
NEXUS_GELF_ENABLED=0
NEXUS_GELF_HOST=192.168.3.10
NEXUS_GELF_PORT=12201
# NEXUS_GELF_SOURCE=nexus-portal-<호스트명>
# 1 이면 AI 응답을 팀 Ollama(OLLAMA_URL)로 바꾼다. 위 AI_PROVIDER 설정과 따로 동작하므로 보통은 0.
NEXUS_OLLAMA_ENABLED=0
# OLLAMA_URL=http://192.168.3.10:11434
